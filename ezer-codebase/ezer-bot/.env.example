EZER_HOST=127.0.0.1
EZER_PORT=8081
EZER_API_KEY=replace-with-a-long-random-secret
EZER_ANTHROPIC_API_KEY=replace-with-your-anthropic-key
EZER_ANTHROPIC_MODEL=claude-sonnet-5
EZER_LLM_MAX_TOKENS=4096
EZER_LLM_TIMEOUT_SECONDS=60

# Accès mail de l'assistant : il passe par le backend, jamais par Microsoft directement.
EZER_BACKEND_URL=http://127.0.0.1:8080
EZER_BACKEND_API_KEY=replace-with-the-backend-api-key
