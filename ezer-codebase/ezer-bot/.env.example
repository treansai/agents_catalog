EZER_ENVIRONMENT=development
EZER_LOG_LEVEL=INFO
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
EZER_API_KEY=replace-with-a-long-random-secret
EZER_ANTHROPIC_API_KEY=replace-with-your-anthropic-key
EZER_ANTHROPIC_MODEL=claude-sonnet-5
EZER_ACCOUNTS_FILE=./accounts.json
EZER_DATABASE_URL=sqlite:///./var/ezer.db
# Production:
# EZER_DATABASE_URL=postgresql://ezer:replace-me@postgres:5432/ezer
# EZER_CHECKPOINT_DATABASE_URL=postgresql://ezer:replace-me@postgres:5432/ezer
# EZER_CHECKPOINT_AES_KEY=replace-with-32-byte-random-key
EZER_POLL_INTERVAL_SECONDS=60
EZER_SYNC_PAGE_SIZE=50
EZER_PROCESSING_CONCURRENCY=4
EZER_PROVIDER_CONCURRENCY=4
EZER_MAX_BODY_CHARS=40000
EZER_MSAL_CACHE_DIR=./var/msal-cache
# Required for device-code authentication in production (16, 24, or 32 bytes):
# EZER_MSAL_CACHE_AES_KEY=replace-with-32-byte-random-key

# Assistant multi-agents : accès aux boîtes via le backend, jamais via Microsoft directement.
EZER_BACKEND_URL=http://backend:8080
EZER_BACKEND_API_KEY=replace-with-the-backend-api-key
