# Laissez ces deux valeurs absentes dans .env.local pour utiliser les données de démonstration.
EZER_API_URL=http://127.0.0.1:8080
EZER_API_KEY=ezer-demo-key

# Assistant multi-agents (ezer-bot). Absentes = l'assistant répond « non configuré ».
EZER_BOT_URL=http://127.0.0.1:8081
EZER_BOT_API_KEY=ezer-bot-demo-key

# Voix (ElevenLabs). Absente = bouton « Parler » inactif côté serveur.
# La clé doit porter les permissions text_to_speech et speech_to_text.
ELEVENLABS_API_KEY=
# Rachel par défaut. eleven_flash_v2_5 est le modèle le moins latent ; eleven_v3 est le plus fidèle.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
# Langue attendue à la transcription. Vide = détection automatique.
ELEVENLABS_STT_LANGUAGE=fra

# Lecture des ordres du tableau de bord (OpenAI, texte seul).
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-4.1-mini

# Fond de carte du composant d'itinéraire. Absente = trajet tracé sur fond uni, sans carte.
# La clé apparaît dans les requêtes de tuiles du navigateur : restreignez-la par domaine
# dans MapTiler (localhost:3000, votre domaine de production).
EZER_MAPTILER_KEY=
EZER_MAPTILER_STYLE=streets-v2-dark
