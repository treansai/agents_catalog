# Laissez ces deux valeurs absentes dans .env.local pour utiliser les données de démonstration.
EZER_API_URL=http://127.0.0.1:8080
EZER_API_KEY=ezer-demo-key

# Commande vocale (OpenAI). Absente = bouton « Parler » inactif côté serveur.
OPENAI_API_KEY=

# Fond de carte du composant d'itinéraire. Absente = trajet tracé sur fond uni, sans carte.
# La clé apparaît dans les requêtes de tuiles du navigateur : restreignez-la par domaine
# dans MapTiler (localhost:3000, votre domaine de production).
EZER_MAPTILER_KEY=
EZER_MAPTILER_STYLE=streets-v2-dark
