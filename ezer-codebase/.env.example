# Root compose configuration. Copy to .env before `docker compose up`.

# Shared secret between the frontend BFF and the NestJS backend.
EZER_API_KEY=ezer-demo-key

# demo: fixtures locales seedées; configured: comptes fournis par EZER_ACCOUNTS_JSON
EZER_MODE=demo
EZER_DEMO_RESET_ON_START=false
EZER_SYNC_DEFAULT_LIMIT=50
EZER_SYNC_MAX_LIMIT=500

# Ports publiés sur 127.0.0.1.
EZER_FRONT_PORT=3000
EZER_BACKEND_PORT=8080
EZER_BOT_PORT=8081

# Assistant multi-agents (ezer-bot). Distinct de EZER_API_KEY.
EZER_BOT_API_KEY=ezer-bot-demo-key
EZER_ANTHROPIC_API_KEY=replace-with-your-anthropic-key
EZER_ANTHROPIC_MODEL=claude-sonnet-5

# Voix (ElevenLabs) transmise au service front : transcription et synthèse.
# La clé doit porter les permissions text_to_speech et speech_to_text.
ELEVENLABS_API_KEY=
# Rachel par défaut. eleven_flash_v2_5 est le modèle le moins latent ; eleven_v3 est le plus fidèle.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
# Langue attendue à la transcription. Vide = détection automatique.
ELEVENLABS_STT_LANGUAGE=fra

# Lecture des ordres du tableau de bord (OpenAI, texte seul).
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-4.1-mini
