# Root compose configuration. Copy to .env before `docker compose up`.

# Shared secret between the frontend BFF and the NestJS backend.
EZER_API_KEY=ezer-demo-key

# demo: fixtures locales seedées; configured: comptes fournis par EZER_ACCOUNTS_JSON
EZER_MODE=demo
EZER_DEMO_RESET_ON_START=false
EZER_SYNC_DEFAULT_LIMIT=50
EZER_SYNC_MAX_LIMIT=500

# Ports publiés sur 127.0.0.1.
EZER_FRONT_PORT=3000
EZER_BACKEND_PORT=8080
EZER_BOT_PORT=8081

# Requis par postgres et le bot Python.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Clé AES de 16, 24 ou 32 octets pour les checkpoints du bot (mode production).
EZER_CHECKPOINT_AES_KEY=replace-with-a-32-character-aes-key

# Clé AES de 16, 24 ou 32 octets pour le cache MSAL du bot (auth device-code).
EZER_MSAL_CACHE_AES_KEY=replace-with-a-32-character-aes-key

# Commande vocale (OpenAI) transmise au service front.
OPENAI_API_KEY=
