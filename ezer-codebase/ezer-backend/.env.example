# demo: fixtures locales seedées; configured: comptes fournis par EZER_ACCOUNTS_JSON
EZER_MODE=demo

# Obligatoire en mode configured. La valeur ci-dessous est strictement locale.
EZER_API_KEY=ezer-demo-key

EZER_PORT=8080
EZER_HOST=127.0.0.1
EZER_DATA_FILE=./data/ezer.json

# true réinitialise explicitement le fichier de données à chaque démarrage en mode demo.
EZER_DEMO_RESET_ON_START=false

# Limites de synchronisation (1..500).
EZER_SYNC_DEFAULT_LIMIT=50
EZER_SYNC_MAX_LIMIT=500

# Mode configured uniquement.
# EZER_ACCOUNTS_JSON=[{"id":"operations","provider":"outlook"}]
# EZER_SOURCE_FILE=./data/messages.json

# Connexion Outlook réelle (mode configured). Un compte doit porter sa boîte pour être connectable.
# EZER_ACCOUNTS_JSON=[{"id":"outlook-perso","provider":"outlook","mailbox":"marctelly@outlook.com"}]
# Application Entra publique, option « Allow public client flows » activée.
# EZER_OUTLOOK_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Refresh tokens délégués, hors du fichier de données du tableau de bord (0600).
EZER_TOKEN_FILE=./data/tokens.json


# Cartographie et itinéraires. Sans ces valeurs, le résolveur places.route retombe sur une liste
# de lieux connus et une estimation à vol d'oiseau, annoncée comme telle dans la sortie.
# Géocodage MapTiler, appelé côté serveur uniquement.
EZER_MAPTILER_KEY=
EZER_MAPTILER_STYLE=streets-v2-dark
# Service de routage au protocole OSRM. En production, hébergez le vôtre ; le serveur public
# de démonstration d'OSRM n'a pas de garantie de disponibilité et interdit l'usage intensif.
# EZER_ROUTING_URL=https://routing.interne.example
# Point de départ par défaut quand l'utilisateur n'en donne pas.
EZER_DEFAULT_ORIGIN=Paris, France
# Géocodeur de repli, utilisé seulement si EZER_MAPTILER_KEY est absente. Les noms de lieux
# demandés sortent alors vers ce service : laissez la valeur vide pour n'émettre aucun appel,
# ou pointez votre propre instance Nominatim. Le service public impose un User-Agent identifiant
# et un usage modéré (une requête par seconde), d'où EZER_MAP_CONTACT.
EZER_NOMINATIM_URL=https://nominatim.openstreetmap.org
EZER_MAP_CONTACT=ezer-agent-ui
